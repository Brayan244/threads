#!/usr/bin/env node
// Dynamic import also works when this executable has no package.json parent.
import('../src/threads/cli.mjs').then(({main})=>main()).then(
  status=>{process.exitCode=status;},
  ()=>{process.stdout.write('{"contract_version":1,"ok":false,"error":{"code":"storage_error","message":"Cannot load local Threads runtime.","retryable":false}}\n');process.exitCode=6;},
);
